# ttyga example profiles — one profile per feature worth knowing about.
# Copy to ~/.config/ttyga/profiles.yaml and edit to suit.
# After editing by hand, press Ctrl+Alt+R in ttyga to reload.

groups:
  - Commands
  - Maintenance
  - Remote
  - Projects
  - Docker
  - Bases

profiles:

  # ------------------------------------------------------------------
  # Commands — utility clippets, typically run in the current tab
  # ------------------------------------------------------------------

  # Paste a command for review before running (default behaviour).
  - name: Disk usage
    group: Commands
    type: clippet
    icon: drive-harddisk-symbolic
    options:
      command: df -h
      auto_execute: false

  # Run immediately in the current tab. Tab label shows the directory name.
  - name: File permissions
    group: Commands
    type: clippet
    icon: system-run-symbolic
    options:
      command: 'find . -maxdepth 1 -printf ''%m %M %u:%g %s %TY-%Tm-%Td %f\n'''
      auto_execute: true
      in_place: true
    classifier:
      title: perms @dir

  # Serve the current directory over HTTPS. Label shows dir and port.
  - name: Serve here
    group: Commands
    type: clippet
    icon: folder-publicshare-symbolic
    options:
      command: python3 -m http.server 8080
      auto_execute: true
      in_place: true
    classifier:
      title: HTTP @dir :8080

  # Multi-line command using YAML block scalar.
  - name: Git status summary
    group: Commands
    type: clippet
    icon: git-symbolic
    options:
      command: |
        git fetch --all
        git log --oneline --graph --decorate -20
      auto_execute: true
      in_place: true

  # ------------------------------------------------------------------
  # Maintenance — tasks that open a new tab and run immediately
  # ------------------------------------------------------------------

  # Auto-execute in a new tab. Custom classifier shows context.
  - name: System update
    group: Maintenance
    type: clippet
    icon: software-update-available-symbolic
    options:
      command: sudo apt update && sudo apt dist-upgrade
      auto_execute: true
    classifier:
      title: APT @host

  # Custom option key used as a classifier token.
  - name: Deploy to production
    group: Maintenance
    type: clippet
    icon: emblem-system-symbolic
    options:
      command: ./deploy.sh production
      auto_execute: true
      target: production
    classifier:
      title: deploy → @target

  # ------------------------------------------------------------------
  # Remote — SSH connections
  # ------------------------------------------------------------------

  # Basic SSH — tab label is user@host by default.
  - name: Webserver
    group: Remote
    type: ssh
    icon: network-server-symbolic
    options:
      host: web.example.com
      user: deploy

  # SSH with a custom tab label.
  - name: Database
    group: Remote
    type: ssh
    icon: network-server-symbolic
    options:
      host: db.example.com
      user: admin
    classifier:
      title: DB — @host

  # SSH with per-profile colour and persistent tmux session.
  # Tab dot turns red; reconnects to the same tmux session on relaunch.
  - name: Production
    group: Remote
    type: ssh
    icon: network-server-symbolic
    color: '#e01b24'
    tmux: true
    tmux_session: prod
    options:
      host: prod.example.com
      user: deploy

  # Mosh connection with tmux — survives network drops and roaming.
  # Type is clippet because mosh is a command, not a direct SSH connection.
  - name: Work (Mosh)
    group: Remote
    type: clippet
    icon: network-wireless-symbolic
    options:
      command: mosh deploy@work.example.com -- tmux attach -t main || tmux new -s main
      auto_execute: true

  # SSH using a ~/.ssh/config alias — user and port come from the config file.
  - name: Project X
    group: Remote
    type: ssh
    icon: folder-remote-symbolic
    options:
      host: project-x    # alias defined in ~/.ssh/config

  # ------------------------------------------------------------------
  # Projects — open a local project directory in a new tab
  # ------------------------------------------------------------------

  # Open a project directory with a custom environment variable.
  - name: My Project
    group: Projects
    type: clippet
    icon: folder-symbolic
    cwd: ~/Projects/my-project
    env:
      KUBECONFIG: ~/.kube/dev
    options:
      command: git status
      auto_execute: true

  # Launch a tool inside a project directory.
  - name: My Project — editor
    group: Projects
    type: clippet
    icon: text-editor-symbolic
    cwd: ~/Projects/my-project
    options:
      command: code .
      auto_execute: true
      in_place: true
    classifier:
      title: code my-project

  # ------------------------------------------------------------------
  # Docker — variable prompts let one profile cover many containers
  # ------------------------------------------------------------------

  # Prompted variable: a dialog asks for the container name before launch.
  # Recent values are remembered and pre-filled next time.
  - name: Container logs
    group: Docker
    type: clippet
    icon: utilities-system-monitor-symbolic
    variables:
      container:
        prompt: Container name
        default: nginx
    classifier:
      title: logs @container
    options:
      command: docker logs -f @container
      auto_execute: true

  - name: Container shell
    group: Docker
    type: clippet
    icon: utilities-terminal-symbolic
    variables:
      container:
        prompt: Container name
        default: nginx
    options:
      command: docker exec -it @container bash
      auto_execute: true

  # ------------------------------------------------------------------
  # Bases — hidden base profiles for inheritance (not shown in sidebar)
  # ------------------------------------------------------------------

  # This profile is hidden; it only exists to be extended.
  - name: staging-base
    hidden: true
    type: ssh
    color: '#e5a50a'
    options:
      host: staging.example.com
      user: deploy

  # Children inherit host, user, and colour from staging-base.
  - name: Staging — shell
    group: Remote
    extends: staging-base

  - name: Staging — htop
    group: Remote
    extends: staging-base
    type: clippet
    options:
      command: htop
      auto_execute: true
